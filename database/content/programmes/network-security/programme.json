  "labs": [
    {
      "slug": "firewall-policy-builder",
      "title": "Design firewall rules for a fictional enterprise",
      "difficulty": "intermediate",
      "labType": "firewall_rules",
      "summary": "Write an ordered rule set for Kanem Logistics' perimeter and internal firewall that allows exactly the required traffic.",
      "minutes": 45,
      "moduleSlug": "firewalls",
      "passPercent": 100,
      "content": {
        "objectives": [
          "Translate business requirements into least-privilege rules",
          "Order rules so the first match produces the intended result"
        ],
        "scenario": "Kanem Logistics (fictional) has five zones: **internet**, **dmz** (public web server), **users** (staff laptops), **servers** (internal applications and database) and **management** (IT admin workstations). The firewall evaluates rules top to bottom; the first match wins, and anything unmatched is denied.",
        "scope": "Rules apply to new connections. Return traffic is handled statefully and does not need rules.",
        "instructions": "Build your rule set with the rule editor. The validator runs 10 test connections against your rules. All must behave as required.",
        "simulationNotice": "This is a simulation. All data is synthetic and generated by AMANIQ Academy for training. No real systems, people or organisations are involved, and nothing you do here leaves the platform.",
        "workspace": {
          "kind": "documents",
          "documents": [
            {
              "title": "Connectivity requirements",
              "format": "markdown",
              "body": "1. Anyone on the internet may reach the public website in the **dmz** on TCP 443.\n2. **users** may browse the internet on TCP 443.\n3. **users** may reach the internal application in **servers** on TCP 443.\n4. The **dmz** web server may query the database in **servers** on TCP 5432. Nothing else from the dmz to internal zones.\n5. Only **management** may administer servers over SSH (TCP 22).\n6. **servers** may send DNS queries to the internet on UDP 53.\n7. Everything else must be blocked."
            }
          ]
        },
        "tasks": [
          {
            "id": "rules",
            "prompt": "Create a rule set that meets all requirements. You can use at most 10 rules.",
            "points": 10,
            "hints": [
              "You do not need an explicit 'deny all' rule: unmatched traffic is denied.",
              "Avoid 'any' destinations for allow rules; least privilege means naming the zone.",
              "Check: can the dmz reach servers on TCP 22? It must not."
            ],
            "input": {
              "type": "firewall",
              "zones": [
                "internet",
                "dmz",
                "users",
                "servers",
                "management"
              ],
              "maxRules": 10
            }
          }
        ]
      },
      "validator": {
        "tasks": {
          "rules": {
            "type": "firewall",
            "flows": [
              {
                "label": "internet → dmz HTTPS",
                "source": "internet",
                "destination": "dmz",
                "protocol": "tcp",
                "port": 443,
                "expect": "allow"
              },
              {
                "label": "users → internet HTTPS",
                "source": "users",
                "destination": "internet",
                "protocol": "tcp",
                "port": 443,
                "expect": "allow"
              },
              {
                "label": "users → servers HTTPS",
                "source": "users",
                "destination": "servers",
                "protocol": "tcp",
                "port": 443,
                "expect": "allow"
              },
              {
                "label": "dmz → servers PostgreSQL",
                "source": "dmz",
                "destination": "servers",
                "protocol": "tcp",
                "port": 5432,
                "expect": "allow"
              },
              {
                "label": "management → servers SSH",
                "source": "management",
                "destination": "servers",
                "protocol": "tcp",
                "port": 22,
                "expect": "allow"
              },
              {
                "label": "servers → internet DNS",
                "source": "servers",
                "destination": "internet",
                "protocol": "udp",
                "port": 53,
                "expect": "allow"
              },
              {
                "label": "internet → servers HTTPS",
                "source": "internet",
                "destination": "servers",
                "protocol": "tcp",
                "port": 443,
                "expect": "deny"
              },
              {
                "label": "dmz → servers SSH",
                "source": "dmz",
                "destination": "servers",
                "protocol": "tcp",
                "port": 22,
                "expect": "deny"
              },
              {
                "label": "users → servers SSH",
                "source": "users",
                "destination": "servers",
                "protocol": "tcp",
                "port": 22,
                "expect": "deny"
              },
              {
                "label": "dmz → users SMB",
                "source": "dmz",
                "destination": "users",
                "protocol": "tcp",
                "port": 445,
                "expect": "deny"
              }
            ],
            "feedback": {
              "correct": "Your rule set allows exactly the required traffic.",
              "incorrect": "At least one test connection behaved incorrectly. Review rule order and any 'any' values."
            }
          }
        }
      }
    },
