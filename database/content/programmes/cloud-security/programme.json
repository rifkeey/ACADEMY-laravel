  "labs": [
    {
      "slug": "iam-excessive-permissions",
      "title": "Identify excessive permissions in an IAM policy",
      "difficulty": "foundation",
      "labType": "config_review",
      "summary": "Review the policy attached to a fictional invoice-processing application and decide which statements break least privilege.",
      "minutes": 30,
      "moduleSlug": "iam",
      "passPercent": 80,
      "content": {
        "objectives": [
          "Read an IAM policy",
          "Recognise wildcard and privilege-escalation risks",
          "Propose a least-privilege alternative"
        ],
        "scenario": "Kanem's invoice application reads invoice files from one storage bucket, decrypts them with one key and writes application logs. A developer attached the policy below during a deadline. Review it.",
        "scope": "The policy uses AWS IAM syntax (provider-specific); the principles apply to every cloud. Account IDs and ARNs are documentation placeholders.",
        "instructions": "Read the policy and the application's needs, then answer the tasks.",
        "simulationNotice": "This is a simulation. All data is synthetic and generated by AMANIQ Academy for training. No real systems, people or organisations are involved, and nothing you do here leaves the platform.",
        "workspace": {
          "kind": "documents",
          "documents": [
            {
              "title": "invoice-app-policy.json",
              "format": "code",
              "language": "json",
              "body": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    { \"Sid\": \"S1\", \"Effect\": \"Allow\", \"Action\": \"s3:GetObject\", \"Resource\": \"arn:aws:s3:::kanem-invoices/*\" },\n    { \"Sid\": \"S2\", \"Effect\": \"Allow\", \"Action\": \"s3:*\", \"Resource\": \"*\" },\n    { \"Sid\": \"S3\", \"Effect\": \"Allow\", \"Action\": [\"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\": \"arn:aws:logs:eu-west-1:111122223333:log-group:/kanem/invoice-app:*\" },\n    { \"Sid\": \"S4\", \"Effect\": \"Allow\", \"Action\": \"iam:PassRole\", \"Resource\": \"*\" },\n    { \"Sid\": \"S5\", \"Effect\": \"Allow\", \"Action\": \"kms:Decrypt\", \"Resource\": \"arn:aws:kms:eu-west-1:111122223333:key/0000aaaa-11bb-22cc-33dd-444455556666\" },\n    { \"Sid\": \"S6\", \"Effect\": \"Allow\", \"Action\": \"ec2:*\", \"Resource\": \"*\" }\n  ]\n}"
            },
            {
              "title": "What the application needs",
              "format": "markdown",
              "body": "- Read objects from the `kanem-invoices` bucket\n- Decrypt with the invoice KMS key\n- Write logs to `/kanem/invoice-app`\n- Nothing else"
            }
          ]
        },
        "tasks": [
          {
            "id": "excessive",
            "prompt": "Which statements grant more than the application needs? Select all.",
            "points": 4,
            "hints": [
              "Look for '*' in Action or Resource.",
              "Compare each statement with the needs list."
            ],
            "input": {
              "type": "multi",
              "options": [
                {
                  "id": "S1",
                  "label": "S1"
                },
                {
                  "id": "S2",
                  "label": "S2"
                },
                {
                  "id": "S3",
                  "label": "S3"
                },
                {
                  "id": "S4",
                  "label": "S4"
                },
                {
                  "id": "S5",
                  "label": "S5"
                },
                {
                  "id": "S6",
                  "label": "S6"
                }
              ]
            }
          },
          {
            "id": "escalation",
            "prompt": "Which statement creates the most direct privilege-escalation risk, because it lets the application hand any role to a service it launches?",
            "points": 3,
            "hints": [
              "Which action relates to roles?"
            ],
            "input": {
              "type": "choice",
              "options": [
                {
                  "id": "S2",
                  "label": "S2"
                },
                {
                  "id": "S4",
                  "label": "S4"
                },
                {
                  "id": "S6",
                  "label": "S6"
                }
              ]
            }
          },
          {
            "id": "fix",
            "prompt": "What is the best remediation?",
            "points": 3,
            "hints": [
              "Least privilege keeps only what is needed."
            ],
            "input": {
              "type": "choice",
              "options": [
                {
                  "id": "remove",
                  "label": "Remove S2, S4 and S6; keep S1, S3 and S5"
                },
                {
                  "id": "mfa",
                  "label": "Keep the policy but require MFA"
                },
                {
                  "id": "deny",
                  "label": "Add a Deny for s3:DeleteObject only"
                }
              ]
            }
          }
        ]
      },
      "validator": {
        "tasks": {
          "excessive": {
            "type": "multi",
            "correct": [
              "S2",
              "S4",
              "S6"
            ],
            "feedback": {
              "correct": "Correct: three wildcard statements unrelated to the application's needs.",
              "incorrect": "Check each statement against the needs list; wildcards are the giveaway."
            }
          },
          "escalation": {
            "type": "choice",
            "correct": "S4",
            "feedback": {
              "correct": "Correct: iam:PassRole on * can let a workload assume far more privilege.",
              "incorrect": "Look for the IAM action that relates to roles."
            }
          },
          "fix": {
            "type": "choice",
            "correct": "remove",
            "feedback": {
              "correct": "Correct.",
              "incorrect": "MFA does not apply to workload identities, and a single Deny leaves most excess in place."
            }
          }
        }
      }
    },
