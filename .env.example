# AMANIQ Academy environment settings.
# Copy to .env and fill in real values ON THE SERVER ONLY. Never commit .env.
# Values marked CHANGE ME must be set before going live.

APP_NAME="AMANIQ Academy"
APP_ENV=production               # local for development
APP_KEY=                         # generate with: php artisan key:generate
APP_DEBUG=false                  # never true in production (refused at boot)
APP_URL=https://academy.amaniqgroup.com

# Public URL printed in certificate QR codes and verification links (must be https in production).
ACADEMY_SITE_URL=https://academy.amaniqgroup.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily                # storage/logs/laravel-YYYY-MM-DD.log, kept 14 days
LOG_LEVEL=warning

# MySQL 8 (create the database and user in cPanel → MySQL Databases).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_database
DB_USERNAME=CHANGE_ME_user
DB_PASSWORD=CHANGE_ME_password

# Sessions and cache live in MySQL, so no Redis or Memcached is needed on shared hosting.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true       # cookies only over HTTPS
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync            # emails send during the request; no queue worker required
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Outgoing email (verification, password reset). Use the SMTP details from cPanel → Email Accounts.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=CHANGE_ME.mail.host
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME@amaniqgroup.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="academy@amaniqgroup.com"
MAIL_FROM_NAME="AMANIQ Academy"

# Payments: paystack | none. ("sandbox" is for development only and is refused in production.)
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET_KEY=             # sk_live_... from the Paystack dashboard (sk_test_ is refused in production)

# Administrators must enable two-factor authentication before using /admin (default: on in production).
REQUIRE_STAFF_2FA=true

VITE_APP_NAME="${APP_NAME}"
